# Copy this to .env for local development — python-dotenv loads it
# automatically. On Render (or any host), set these as real environment
# variables in the dashboard instead; don't upload a .env file there.

# --- Cloud storage (optional) ---
# Leave all of these blank to use local temp storage (the default).
# Fill them in to upload finished downloads to S3-compatible storage
# (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO...)
# and serve a signed link instead. See storage.py for details.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_URL_EXPIRES_SECONDS=3600

# --- Local storage guard (used even when cloud storage is on, since
# files are briefly written here before upload) ---
MIN_FREE_MB=500

# --- YouTube bot-check mitigations (optional) ---
# See the "YouTube blocking" section in README.md before using these.
# YOUTUBE_COOKIES_B64: base64 of a cookies.txt exported from a real,
# logged-in YouTube session. Raises trust, but expires — expect to
# refresh it occasionally. Use a throwaway account, not your main one.
YOUTUBE_COOKIES_B64=

# YTDLP_PROXY: e.g. http://user:pass@residential-proxy-host:port
# The most reliable fix for a persistently flagged server IP, at the
# cost of a paid proxy subscription. Leave blank to not use one.
YTDLP_PROXY=

